{
  "name": "agent-web",
  "version": "1.0.0",
  "description": "Widget embeddable de agente de voz con IA para cualquier pagina web",
  "type": "module",
  "main": "dist/agent-web.min.js",
  "module": "src/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --filter ui",
    "test:core": "vitest --filter core",
    "test:utils": "vitest --filter utils",
    "test:all": "vitest run --reporter verbose",
    "check": "npm run lint && npm run test"
  },
  "keywords": [
    "widget",
    "voice",
    "ai",
    "chatbot",
    "web-agent",
    "openai",
    "voice-assistant"
  ],
  "author": "agent-web",
  "license": "MIT",
  "devDependencies": {
    "vite": "^5.0.0",
    "vitest": "^1.2.0",
    "jsdom": "^23.0.0",
    "@vitest/browser": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-config-airbnb-base": "^15.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "AGENTS.md",
    "ARCHIVES.md",
    "TROUBLESHOOTING.md",
    "README.md"
  ],
  "homepage": "https://github.com/josem/agent-web#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/josem/agent-web.git"
  },
  "bugs": {
    "url": "https://github.com/josem/agent-web/issues"
  }
}
