{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install && npm run build"
      }
    }
  ],
  "routes": [
    {"src": "/widget.js", "dest": "/dist/widget.js"},
    {"src": "/config.html", "dest": "/dist/config.html"},
    {"src": "/config", "dest": "/dist/config.html"}
  ]
}
