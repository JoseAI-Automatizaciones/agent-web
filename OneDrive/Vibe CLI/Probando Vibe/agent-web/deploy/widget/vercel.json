{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install && npm run build"
      }
    }
  ],
  "rewrites": [
    {"source": "/config", "destination": "/dist/config.html"},
    {"source": "/widget.js", "destination": "/dist/widget.js"}
  ]
}
